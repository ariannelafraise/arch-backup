{
  "hyprland/workspaces": {
    "format-icons": {
      "default": "<span color='#ffffff' alpha='100%'>♥</span>",
      "special": "<span color='#ffffff' alpha='100%'></span>",
      "active": "<span color='#ffaacc' alpha='100%'></span>", //  󰊠  󰢚 󰭟 󰄛 󰋑
    },
    "format": "{icon} {name}",
    "show-special": false,
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": " {device_alias} 󰁹 {device_battery_percentage}%",
    "tooltip": true,
    "on-click": "blueman-manager",
  },

  "custom/lock": {
    "format": "<span color='#ffffff'></span>",
    "tooltip-format": "Lock",
    "on-click": "hyprlock",
  },

  "custom/restart": {
    "format": "<span color='#ffffff'></span>",
    "tooltip-format": "Restart",
    "on-click": "reboot",
  },

  "custom/shutdown": {
    "format": "<span color='#ffffff'></span>",
    "tooltip-format": "Shutdown",
    "on-click": "poweroff",
  },

  "custom/hrt": {
    "format": "󱄿 {}",
    "exec": "~/personal_dev/hrt-time/hrt-time.sh years",
    "interval": 14400,
    "tooltip": false,
  },

  "clock": {
    "format": "{:%H:%M}",
    "rotate": 0,
    "format-alt": "󰃭 {:%d/%m/%Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#fc58b2'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weekdays": "<span color='#fc58b2'><b>{}</b></span>",
        "today": "<span color='#f458fc'><b>{}</b></span>",
      },
    },
  },

  "battery": {
    "states": {
      "warning": 50,
      "critical": 30,
    },
    "interval": 1,
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": "󱐋 {capacity}%",
    "format-alt": "{icon} {time}",
  },

  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "",
    "tooltip-format": "{essid}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "󰤭",
    "format": " {ifname}",
    "on-click": "nm-connection-editor",
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "on-click": "pavucontrol",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
  },

  "tray": {
    "icon-size": 20,
    "spacing": 5,
  },
}
